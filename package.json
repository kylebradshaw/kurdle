{
  "name": "kurdle",
  "version": "0.14.11",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "tdd": "vitest",
    "test:coverage": "vitest run --coverage",
    "start-pwa": "ng build && http-server -p 8080 -c-1 dist/ng-kurdle/browser",
    "dev": "netlify dev",
    "e2e": "playwright test --ignore-snapshots",
    "e2e:visual": "playwright test e2e/visual/ --ignore-snapshots"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@netlify/functions": "^2.8.0",
    "base-64": "^1.0.0",
    "bootstrap": "^5.1.3",
    "date-fns": "^2.28.0",
    "date-fns-tz": "^1.2.2",
    "lodash": "^4.17.21",
    "random-js": "^2.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular-devkit/build-angular": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@playwright/test": "^1.58.2",
    "@types/base-64": "^1.0.0",
    "@types/lodash": "^4.14.178",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.1"
  }
}
